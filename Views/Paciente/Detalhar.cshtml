@model Agendamento.Models.Paciente

@{
    ViewData["Title"] = "Detalhes do Paciente";
}

<h1>Detalhes do Paciente</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.PacienteId</dd>

        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">CPF</dt>
        <dd class="col-sm-10">@Formatador.FormatarCPF(Model.CPF)</dd>

        <dt class="col-sm-2">Telefone</dt>
        <dd class="col-sm-10">@Formatador.FormatarTelefone(Model.Telefone)</dd>

        <dt class="col-sm-2">Endereço</dt>
        <dd class="col-sm-10">@Model.Endereco</dd>

        <dt class="col-sm-2">Data de Nascimento</dt>
        <dd class="col-sm-10">@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>
    </dl>

    <a asp-action="Editar" asp-route-id="@Model.PacienteId" class="btn btn-outline-secondary">Editar</a>
    <a asp-action="Index" class="btn btn-outline-info">Voltar</a>
    <hr />
</div>
