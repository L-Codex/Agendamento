@model List<Agendamento.Models.Paciente>
@{
    ViewData["Title"] = "Pacientes";

}

<h1>Pacientes</h1>

<p>
    <a asp-action="Inserir" class="btn btn-success">Inserir</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>Telefone</th>
            <th>Endereço</th>
            <th>Data de Nascimento</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var paciente in Model)
        {
            <tr>
                <td>@paciente.PacienteId</td>
                <td>@paciente.Nome</td>
                <td>@Formatador.FormatarCPF(paciente.CPF)</td>
                <td>@Formatador.FormatarTelefone(paciente.Telefone)</td>
                <td>@paciente.Endereco</td>
                <td>@paciente.DataNascimento.ToString("dd/MM/yyyy")</td>
                <td class="acoes">
                    <a asp-action="Detalhar" asp-route-id="@paciente.PacienteId" class="btn btn-outline-warning">Detalhar</a>
                    <a asp-action="Editar" asp-route-id="@paciente.PacienteId" class="btn btn-outline-info">Editar</a>
                    <a asp-action="Remover" asp-route-id="@paciente.PacienteId" class="btn btn-outline-danger">Remover</a>
                </td>
            </tr>
        }
    </tbody>
</table>

