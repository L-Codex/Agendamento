@model List<Agendamento.Models.Medico>
@{
 ViewData["Title"] = "Medicos";

}

 <h1>Medicos</h1>

 <p>
     <a asp-action="Inserir" class="btn btn-success">Inserir</a>
 </p>
<table class="table table-striped table-hover">
    <thead>  
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>CRM</th>
            <th>Especialidade</th>
        </tr>
    </thead>
    <tbody>
         @foreach (var medico in Model)
         { 
            <tr>   
                <td>@medico.Id</td>
                <td>@medico.Nome</td>
                <td>@medico.Crm</td>
                <td>@medico.Especialidade</td>
                <td class="acoes">
                    <a asp-action="Detalhar" asp-route-id="@medico.Id" class="btn btn-outline-warning">Detalhar</a>
                    <a asp-action="Editar" asp-route-id="@medico.Id" class="btn btn-outline-info">Editar</a>
                    <a asp-action="Remover" asp-route-id="@medico.Id" class="btn btn-outline-danger">Remover</a>
                </td>
            </tr>
         }   
    </tbody>
    </table>